function imfs=my_emd(signal,varargin)
    p=inputParser;%参数解析器
    % === Required（必选参数）===
    % 格式：addRequired(解析器, '参数名', 验证函数)
    addRequired(p,'signal',@isnumeric);
    % === Parameter（可选参数，有默认值）===
    % 格式：addParameter(解析器, '参数名', 默认值, 验证函数)
    addParameter(p,'Interpolation','pchip',@ischar); %包络线插值方法，默认 'pchip'（保形，不易过冲）
    addParameter(p,'MaxNumIMF',10,@isnumeric);%最多分解出多少个 IMF
    addParameter(p,'SiftMaxIter',100,@isnumeric);%单层 IMF 筛选的最大迭代次数，防止某一层剥太久卡死
    addParameter(p,'SiftRelativeTolerance',0.2,@isnumeric);%SD 停止准则的阈值，越小剥得越精细、迭代越多
    addParameter(p, 'EndPointMethod', 'mirror', @ischar);  % 端点处理方式，默认 'mirror'（镜像延拓）
    addParameter(p, 'Verbose', true, @islogical); %是否打印详细过程，默认 false（不打印），调试时传 true 可以看到每层 IMF 的迭代信息
    parse(p,signal,varargin{:});

    % 获取参数
    interp_method = p.Results.Interpolation;% 取出插值方法
    max_imf = p.Results.MaxNumIMF;% 取出最大 IMF 数
    max_iter = p.Results.SiftMaxIter;% 取出最大筛选迭代次数
    tol = p.Results.SiftRelativeTolerance;% 取出 SD 停止阈值
    endpoint_method = p.Results.EndPointMethod;% 取出端点处理方式
    verbose = p.Results.Verbose; % 取出是否打印详细过程

    %% 初始化
    signal = signal(:);%转成列向量
    n = length(signal);%信号长度（采样点数）
    t_original = (1:n)';% 原始时间轴（1,2,3,...,n），用于插值拟合包络线时做横坐标
    
    residue = signal;%残差，初始就是原始信号本身；每剥出一层IMF就从它里面减掉
    imfs = [];% 用来存所有剥出来的IMF，每剥出一层就往后面拼一列
    
    if verbose% 如果开了详细模式，就打印一些提示信息
        fprintf('开始EMD分解...\n');
        fprintf('插值方法: %s\n', interp_method);
        fprintf('端点处理: %s\n', endpoint_method);
    end
    
    %% 主分解循环
    for k = 1:max_imf
        if verbose
            fprintf('\n提取第%d个IMF...\n', k);
        end
        
       
        h = residue; % 当前要剥的信号：第一次是原信号，之后是上一轮剩下的残差
        h_prev = h;% 保存上一轮的 h，用于对比（后面没用到，可留作调试）
        
        % 筛选循环,把h剥成一层干净的IMF
        for iter = 1:max_iter
            %% 步骤1：端点处理
            % 信号两头没有极值点，直接连包络线会飞出去
            % 所以先"照镜子"在两头各补一段，剥完再剪掉
            if strcmp(endpoint_method, 'mirror')
                ext_len = min(20, floor(n/10));
                [h_ext, orig_len] = endpoint_mirror_extension(h, ext_len);
                t_ext = (1:length(h_ext))';
            else
                h_ext = h;
                t_ext = t_original;
            end
            
            %% 步骤2：找极值点（改进版）
            [max_locs, max_vals, min_locs, min_vals] = improved_find_extrema(h_ext);
            
            % 极值点太少,就没法连出像样的包络线，这层不用剥
            if length(max_locs) + length(min_locs) < 4
                if verbose
                    fprintf('  极值点太少，停止筛选\n');
                end
                break;
            end
            
            %% 步骤3：构建包络线
            try
                % 默认用 pchip 插值：保形，不会在极值之间甩出去
                upper_env = interp1(max_locs, max_vals, t_ext, interp_method, 'extrap');
                lower_env = interp1(min_locs, min_vals, t_ext, interp_method, 'extrap');
            catch
                % 如果插值失败，尝试线性插值
                upper_env = interp1(max_locs, max_vals, t_ext, 'linear', 'extrap');
                lower_env = interp1(min_locs, min_vals, t_ext, 'linear', 'extrap');
            end
            
            %% 步骤4：计算均值包络
            % 上下包络线取平均，得到"局部平均线"
            mean_env = (upper_env + lower_env) / 2;
            
            %% 步骤5：恢复原始长度
            % 如果之前做了镜像延拓，现在要把补的那段剪掉，只保留原信号长度
            if strcmp(endpoint_method, 'mirror')
                mean_env = remove_extension(mean_env, orig_len, ext_len);
                h_new = h - mean_env;% 原信号减去局部平均线，得到新的 h
            else
                h_new = h - mean_env;% 没延拓就直接减
            end
            
            %% 步骤6：停止准则检查
            % 判断这层剥好了没有，三个条件同时满足才停

            % 准则1：SD准则— 这次减完和上次减完，差别大不大
            sd = sum((h - h_new).^2) / (sum(h.^2) + eps);% eps 防止除以 0
            
            % 准则2：过零点条件,过零点和极值点数量是不是差不多
            % IMF 的理想状态是"窄带"，过零点和极值点应该一一对应
            zero_crossings = sum(diff(sign(h_new)) ~= 0);% 数过零点
            [pks_max, ~] = findpeaks(h_new);% 波峰数
            [pks_min, ~] = findpeaks(-h_new);% 波谷数（取负后找峰）
            extrema_count = length(pks_max) + length(pks_min);
            crossing_ok = abs(zero_crossings - extrema_count) <= 1;% 差不超过1就算合格
            
            % 准则3：均值条件— 上下包络是不是基本对称了
            mean_env_rms = rms(mean_env); % 平均线的能量
            signal_rms = rms(h_new); % 信号本身的能量
            mean_ok = mean_env_rms < 0.05 * signal_rms;% 平均线小到可以忽略
            
            % 每 10 次迭代打印一次进度，方便调试
            if verbose && mod(iter, 10) == 0
                fprintf('  迭代%d: SD=%.4f, 过零点=%d, 极值点=%d\n', ...
                    iter, sd, zero_crossings, extrema_count);
            end
            
            % 三个条件都满足 → 这层剥好了，退出筛选循环
            if sd < tol && crossing_ok && mean_ok
                if verbose
                    fprintf('  第%d次迭代满足所有停止条件\n', iter);
                end
                break;
            end

            % 兜底：SD 小到离谱，说明再剥也没意义了，强制停
            if sd < tol/10 
                if verbose
                    fprintf('  SD非常小，强制停止\n');
                end
                break;
            end
            
            % 还没剥好，把 h_new 当作下一轮的输入，继续剥
            h_prev = h;
            h = h_new;
        end
        
         %% ========== 筛选结束，保存这一层 IMF ==========
        imf = h;
        
        % 模式混叠检测,怀疑这层里混了不同节奏，打印个警告（不影响主流程）
        [is_mixing, mix_ratio] = detect_mode_mixing(imf);
        if is_mixing && verbose
            fprintf('  警告：检测到可能的模式混叠 (比率=%.2f)\n', mix_ratio);
        end

        % 把这一层加到 IMF 矩阵里（每列一个 IMF）
        imfs = [imfs, imf];
        
        %% 更新残差：原信号减去刚剥出来的这层，剩下的继续剥
        residue = residue - imf;
        
        %% 检查是否继续分解
        % 如果残差里几乎没波峰波谷了，说明剩下的只是趋势，不用再剥
        n_extrema = length(findpeaks(residue)) + length(findpeaks(-residue));
        
        if n_extrema < 3
            if verbose
                fprintf('残差已无明显波动，添加为最后一个分量\n');
            end
            imfs = [imfs, residue];
            break;
        end
        
        % 如果残差能量已经小到可以忽略，也停
        if var(residue) < var(signal) * 1e-4
            if verbose
                fprintf('残差能量很小，停止分解\n');
            end
            imfs = [imfs, residue];
            break;
        end
    end
    %% ========== 分解完成，打印统计信息 ==========
    if verbose
        fprintf('\nEMD分解完成！共提取%d个IMF\n', size(imfs, 2));
        fprintf('重构误差MSE: %.2e\n', mean((signal - sum(imfs, 2)).^2));
    end
end

%% 辅助函数
% 端点镜像延拓：在信号两头"照镜子"补一段，防止包络线飞出去
function [extended_signal, original_length] = endpoint_mirror_extension(signal, ext_length)
    signal = signal(:);
    n = length(signal);
    original_length = n;
    
    % 左端镜像
    %以 signal(1) 为镜子，把左边的点翻折出去
    % 从 signal(2) 开始往右取，翻折后放到左边（用 :−1: 倒序）
    left_ext = 2*signal(1) - signal(min(ext_length+1, n):-1:2);
    % 如果信号太短，镜像点不够 ext_length 个，就用最后一个值重复补齐
    if length(left_ext) < ext_length
        %repmat(值, 个数, 1)	把这个值复制成列向量
        left_ext = [left_ext; repmat(left_ext(end), ext_length-length(left_ext), 1)];
    end
    
    % 右端镜像
    right_ext = 2*signal(end) - signal(end-1:-1:max(1, end-ext_length));
    if length(right_ext) < ext_length
        right_ext = [repmat(right_ext(end), ext_length-length(right_ext), 1); right_ext];
    end

    %% 拼起来：左延拓 + 原信号 + 右延拓
    extended_signal = [left_ext(:); signal; right_ext(:)];
end

%% 剪掉延拓：把之前镜像补的那段去掉，只留原信号长度
function original_signal = remove_extension(extended_signal, original_length, ext_length)
    % 所以原信号在 extended_signal 里的位置是：ext_length+1 到 ext_length+original_length
    original_signal = extended_signal(ext_length+1:ext_length+original_length);
end

function [maxima_idx, maxima_val, minima_idx, minima_val] = improved_find_extrema(signal)
    % 改进的极值点检测（已在前面定义）
    n = length(signal);
    signal = signal(:);
    
    maxima_idx = [];
    maxima_val = [];
    minima_idx = [];
    minima_val = [];
    
    for i = 2:n-1
        if signal(i) > signal(i-1) && signal(i) >= signal(i+1)
            maxima_idx = [maxima_idx; i];
            maxima_val = [maxima_val; signal(i)];
        end
        if signal(i) < signal(i-1) && signal(i) <= signal(i+1)
            minima_idx = [minima_idx; i];
            minima_val = [minima_val; signal(i)];
        end
    end
end

function [is_mixing, mixing_ratio] = detect_mode_mixing(imf)
    % 模式混叠检测
    n = length(imf);
    
    % 简化的Hilbert变换
    X = fft(imf);
    h = zeros(n,1);
    if mod(n,2) == 0
        h([1, n/2+1]) = 1;
        h(2:n/2) = 2;
    else
        h(1) = 1;
        h(2:(n+1)/2) = 2;
    end
    
    Y = X .* h;
    y = ifft(Y);
    
    % 瞬时频率
    phase = unwrap(angle(y));
    inst_freq = abs(diff(phase) / (2*pi));
    inst_freq = [inst_freq; inst_freq(end)];
    
    % 检测
    freq_std = std(inst_freq);
    freq_mean = mean(inst_freq);
    mixing_ratio = freq_std / (freq_mean + eps);
    is_mixing = mixing_ratio > 0.5;
end